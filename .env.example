# Адрес сайта. Для собственного домена:
NUXT_PUBLIC_SITE_URL=https://vidtechnology.ru
NUXT_APP_BASE_URL=/

# Для GitHub Pages проекта painter:
# NUXT_PUBLIC_SITE_URL=https://YOUR_LOGIN.github.io/painter
# NUXT_APP_BASE_URL=/painter/

# SMTP для отправки заявок. Пример для Mail.ru/Yandex/другого SMTP.
# На большинстве почтовых сервисов нужен пароль приложения, а не обычный пароль от почты.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Vidtechnology@mail.ru
SMTP_PASS=PASTE_APP_PASSWORD_HERE
MAIL_FROM="ELASTIC PRO <Vidtechnology@mail.ru>"
LEAD_RECIPIENT_EMAIL=Vidtechnology@mail.ru
